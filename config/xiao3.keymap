#include <dt-bindings/led/led.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        RelativeParent: RelativeParent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp DOT &kp FSLH>;
            label = "RELATIVEPARENT";
        };

        bt_clr: bt_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
            label = "BT_CLR";
        };

        bt_clr_all: bt_clr_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR_ALL>;
            label = "BT_CLR_ALL";
        };
    };

    behaviors {
        EscCaps: EscCaps {
            compatible = "zmk,behavior-tap-dance";
            label = "ESCCAPS";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE>, <&caps_word>;

            tapping-term-ms = <150>;
        };

        LayerDance: LayerDance {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYERDANCE";
            #binding-cells = <0>;
            bindings = <&sl 2>, <&tog 3>, <&sl 4>;
        };

        HoldKp: HoldKp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDKP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            flavor = "balanced";
            retro-tap;
            require-prior-idle-ms = <150>;
        };

        Hold_BT_CLR: Hold_BT_CLR {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_BT_CLR";
            bindings = <&bt_clr>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <1000>;
            flavor = "tap-preferred";
        };

        Hold_Bootloader: Hold_Bootloader {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_BOOTLOADER";
            bindings = <&bootloader>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <1000>;
            flavor = "tap-preferred";
        };

        Hold_BT_CLR_ALL: Hold_BT_CLR_ALL {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_BT_CLR_ALL";
            bindings = <&bt_clr_all>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <1000>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Alpha {
            bindings = <
&kp PRINTSCREEN  &kp N1  &kp N2  &kp N3        &kp N4                    &kp N5            &kp N6       &kp N7                     &kp N8         &kp N9      &kp N0     &kp HOME
&kp TAB          &kp X   &kp L   &kp D         &kp P                     &kp V             &kp Z        &kp K                      &kp O          &kp U       &kp MINUS  &kp DEL
&EscCaps         &kp N   &kp R   &kp T         &kp S                     &kp G             &kp Y        &kp H                      &kp A          &kp E       &kp I      &kp INSERT
&kp LEFT_SHIFT   &kp Q   &kp J   &kp M         &kp C                     &kp W             &kp B        &kp F                      &kp COMMA      &kp PERIOD  &kp APOS   &kp END
                                 &kp LCTRL     &HoldKp LEFT_SHIFT SPACE  &LayerDance       &LayerDance  &HoldKp RIGHT_SHIFT ENTER  &mo 1
                                 &kp LEFT_GUI  &key_repeat               &kp UNDERSCORE    &kp DOLLAR   &kp BACKSPACE              &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans        &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans        &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans        &trans     &trans
                        &trans  &trans  &trans    &trans  &trans    &trans
                        &trans  &trans  &trans    &trans  &trans    &trans
            >;
        };

        Symbols {
            bindings = <
&kp F1  &kp F2            &kp F3         &kp F4            &kp F5             &kp F6             &kp F7         &kp F8         &kp F9                &kp F10                &kp F11       &kp F12
&trans  &kp SINGLE_QUOTE  &kp LESS_THAN  &kp GREATER_THAN  &kp DOUBLE_QUOTES  &kp PERIOD         &kp AMPERSAND  &kp HASH       &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PERCENT   &trans
&trans  &kp EXCLAMATION   &kp MINUS      &kp PLUS          &kp EQUAL          &kp GRAVE          &kp PIPE       &kp COLON      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION  &trans
&trans  &kp CARET         &kp SLASH      &kp ASTERISK      &kp BACKSLASH      &RelativeParent    &kp TILDE      &kp SEMICOLON  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp AT_SIGN   &trans
                                         &trans            &trans             &trans             &trans         &trans         &trans
                                         &trans            &trans             &trans             &trans         &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Numpad {
            bindings = <
&trans  &trans  &trans    &trans        &trans     &trans         &trans       &trans  &kp SLASH  &kp ASTERISK  &trans     &trans
&trans  &trans  &trans    &kp UP_ARROW  &trans     &trans         &trans       &kp N7  &kp N8     &kp N9        &kp MINUS  &trans
&trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans         &kp COMMA    &kp N4  &kp N5     &kp N6        &kp PLUS   &trans
&trans  &trans  &trans    &trans        &trans     &trans         &kp PERIOD   &kp N1  &kp N2     &kp N3        &trans     &trans
                          &trans        &trans     &LayerDance    &LayerDance  &kp N0  &kp ENTER
                          &trans        &trans     &trans         &trans       &trans  &trans
            >;
        };

        Danger {
            bindings = <
&sys_reset  &trans        &trans        &trans        &trans        &Hold_Bootloader 0 0    &Hold_Bootloader 0 0  &trans  &trans  &trans  &trans  &sys_reset
&trans      &trans        &trans        &trans        &trans        &trans                  &trans                &trans  &trans  &trans  &trans  &trans
&trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans                  &trans                &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                  &Hold_BT_CLR 0 0      &trans  &trans  &trans  &trans  &Hold_BT_CLR_ALL 0 0
                                        &trans        &trans        &trans                  &trans                &trans  &trans
                                        &trans        &trans        &trans                  &trans                &trans  &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
